#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
RUNTIME_DIR="/opt/zvpn-panel/runtime"
RUNTIME_SECRETS="${RUNTIME_DIR}/ipsec-users.secrets"
IPSEC_SECRETS="/etc/ipsec.d/zvpn-users.secrets"
IPSEC_CONF="/etc/ipsec.conf"
CA_CERT="/etc/ipsec.d/cacerts/ikev2-ca-cert.pem"
CA_KEY="/etc/ipsec.d/private/ikev2-ca-key.pem"
SERVER_CERT="/etc/ipsec.d/certs/ikev2-server-cert.pem"
SERVER_KEY="/etc/ipsec.d/private/ikev2-server-key.pem"
BACKUP_ROOT="/var/lib/zvpn-panel/endpoint-backups"

# Backups contain private keys and are intentionally root-only.  Every path
# accepted from the unprivileged panel is canonicalised and must remain below
# this directory; this prevents path traversal and symlink swaps through the
# sudo helper.
ensure_root_backup_dir() {
  [[ ! -L /var/lib/zvpn-panel && ! -L "$BACKUP_ROOT" ]] || return 1
  install -o root -g root -m 700 -d /var/lib/zvpn-panel "$BACKUP_ROOT"
  [[ "$(stat -c '%u:%g:%a' "$BACKUP_ROOT")" == "0:0:700" ]]
}

validate_backup_dir() {
  local candidate="${1:-}" real_root real_candidate base file
  [[ -n "$candidate" && -d "$candidate" && ! -L "$candidate" ]] || return 1
  real_root="$(realpath -e -- "$BACKUP_ROOT")" || return 1
  real_candidate="$(realpath -e -- "$candidate")" || return 1
  [[ "$(dirname -- "$real_candidate")" == "$real_root" ]] || return 1
  base="$(basename -- "$real_candidate")"
  [[ "$base" =~ ^[0-9]{10,}-[0-9]+-[a-f0-9]{16}$ ]] || return 1
  [[ "$(stat -c '%u:%g' "$real_candidate")" == "0:0" ]] || return 1
  (( (8#$(stat -c '%a' "$real_candidate") & 8#077) == 0 )) || return 1
  for file in ipsec.conf ipsec.secrets ikev2-server-cert.pem ikev2-server-key.pem SHA256SUMS; do
    [[ -f "$real_candidate/$file" && ! -L "$real_candidate/$file" ]] || return 1
    [[ "$(stat -c '%u:%g' "$real_candidate/$file")" == "0:0" ]] || return 1
  done
  (cd "$real_candidate" && sha256sum --status -c SHA256SUMS) || return 1
  printf '%s\n' "$real_candidate"
}

validate_identity() {
  local id="${1:-}"
  [[ -n "$id" && ${#id} -le 253 ]] || return 1
  if [[ "$id" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    IFS='.' read -r a b c d <<< "$id"
    for o in "$a" "$b" "$c" "$d"; do
      [[ "$o" -ge 0 && "$o" -le 255 ]] || return 1
    done
    return 0
  fi
  [[ "$id" =~ ^[a-zA-Z0-9]([a-zA-Z0-9.-]{0,61}[a-zA-Z0-9])?$ ]]
}

case "$ACTION" in
  sync-secrets)
    [[ -f "$RUNTIME_SECRETS" && ! -L "$RUNTIME_SECRETS" ]] || { echo "runtime secrets missing or unsafe" >&2; exit 3; }
    RUNTIME_REAL="$(realpath -e -- "$RUNTIME_SECRETS")"
    [[ "$(dirname -- "$RUNTIME_REAL")" == "$(realpath -e -- "$RUNTIME_DIR")" ]] || { echo "runtime secrets outside runtime directory" >&2; exit 3; }
    [[ "$(stat -c '%u' "$RUNTIME_SECRETS")" == "$(id -u zvpn)" ]] || { echo "runtime secrets owner is invalid" >&2; exit 3; }
    (( (8#$(stat -c '%a' "$RUNTIME_SECRETS") & 8#077) == 0 )) || { echo "runtime secrets permissions are too broad" >&2; exit 3; }
    TMP="${IPSEC_SECRETS}.tmp.$$"
    install -o root -g root -m 600 "$RUNTIME_SECRETS" "$TMP"
    mv -f "$TMP" "$IPSEC_SECRETS"
    /usr/sbin/ipsec rereadsecrets
    ;;
  reread-secrets)
    exec /usr/sbin/ipsec rereadsecrets
    ;;
  list-sas)
    exec /usr/sbin/swanctl --list-sas --raw
    ;;
  terminate)
    ID="${2:-}"
    [[ "$ID" =~ ^[0-9]+$ ]] || { echo "invalid ike id" >&2; exit 2; }
    exec /usr/sbin/swanctl --terminate --ike-id "$ID" --timeout 5
    ;;
  status)
    exec /usr/sbin/ipsec statusall
    ;;
  cert-info)
    [[ -f "$SERVER_CERT" ]] || { echo "CN="; echo "SAN="; echo "NOT_AFTER="; echo "LEFTID="; exit 0; }
    CN="$(openssl x509 -in "$SERVER_CERT" -noout -subject 2>/dev/null | sed -E 's/.*CN\s*=\s*//; s/,.*//; s/^\s+//')"
    SAN="$(openssl x509 -in "$SERVER_CERT" -noout -ext subjectAltName 2>/dev/null | grep -oE 'DNS:[^,]+|IP Address:[^,]+' | paste -sd, - || true)"
    NOT_AFTER="$(openssl x509 -in "$SERVER_CERT" -noout -enddate 2>/dev/null | cut -d= -f2-)"
    LEFTID="$(grep -E '^[[:space:]]*leftid=' "$IPSEC_CONF" 2>/dev/null | head -1 | sed -E 's/^[[:space:]]*leftid=//')"
    echo "CN=${CN}"
    echo "SAN=${SAN}"
    echo "NOT_AFTER=${NOT_AFTER}"
    echo "LEFTID=${LEFTID}"
    ;;
  resolve-host)
    HOST="${2:-}"
    validate_identity "$HOST" || { echo "invalid host" >&2; exit 2; }
    [[ "$HOST" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] && { echo "$HOST"; exit 0; }
    dig +short A "$HOST" | grep -E '^[0-9.]+$' || true
    ;;
  check-ike-ports)
    ss -ulnp 2>/dev/null | grep -q ':500 ' && echo UDP500=1 || echo UDP500=0
    ss -ulnp 2>/dev/null | grep -q ':4500 ' && echo UDP4500=1 || echo UDP4500=0
    ;;
  endpoint-backup)
    ensure_root_backup_dir || { echo "unsafe backup root" >&2; exit 3; }
    umask 077
    DIR="${BACKUP_ROOT}/$(date +%s)-$$-$(openssl rand -hex 8)"
    install -o root -g root -m 700 -d "$DIR"
    cp -a "$IPSEC_CONF" "$DIR/ipsec.conf"
    cp -a /etc/ipsec.secrets "$DIR/ipsec.secrets"
    cp -a "$SERVER_CERT" "$DIR/ikev2-server-cert.pem"
    cp -a "$SERVER_KEY" "$DIR/ikev2-server-key.pem"
    chmod 600 "$DIR/ipsec.conf" "$DIR/ipsec.secrets" "$DIR/ikev2-server-key.pem"
    chmod 644 "$DIR/ikev2-server-cert.pem"
    (cd "$DIR" && sha256sum ipsec.conf ipsec.secrets ikev2-server-cert.pem ikev2-server-key.pem > SHA256SUMS)
    chmod 600 "$DIR/SHA256SUMS"
    echo "$DIR"
    ;;
  endpoint-rollback)
    ensure_root_backup_dir || { echo "unsafe backup root" >&2; exit 3; }
    DIR="${2:-}"
    DIR="$(validate_backup_dir "$DIR")" || { echo "invalid backup dir" >&2; exit 2; }
    install -o root -g root -m 600 "$DIR/ipsec.conf" "$IPSEC_CONF"
    install -o root -g root -m 600 "$DIR/ipsec.secrets" /etc/ipsec.secrets
    install -o root -g root -m 644 "$DIR/ikev2-server-cert.pem" "$SERVER_CERT"
    install -o root -g root -m 600 "$DIR/ikev2-server-key.pem" "$SERVER_KEY"
    chmod 644 "$SERVER_CERT"
    chmod 600 "$SERVER_KEY"
    systemctl restart strongswan-starter
    ;;
  issue-server-cert)
    ID="${2:-}"
    validate_identity "$ID" || { echo "invalid identity" >&2; exit 2; }
    [[ -f "$CA_CERT" && -f "$CA_KEY" && -f "$SERVER_KEY" ]] || { echo "missing CA or server key" >&2; exit 3; }
    TMP="$(mktemp)"
    pki --pub --in "$SERVER_KEY" --type rsa | pki --issue --lifetime 1825 \
      --cacert "$CA_CERT" --cakey "$CA_KEY" --dn "CN=${ID}" --san "$ID" \
      --flag serverAuth --outform pem > "$TMP"
    install -o root -g root -m 644 "$TMP" "$SERVER_CERT"
    rm -f "$TMP"
    echo "issued"
    ;;
  set-leftid)
    ID="${2:-}"
    validate_identity "$ID" || { echo "invalid identity" >&2; exit 2; }
    [[ -f "$IPSEC_CONF" ]] || { echo "ipsec.conf missing" >&2; exit 3; }
    BAK="${RUNTIME_DIR}/ipsec.conf.zvpn.bak.$$"
    cp -a "$IPSEC_CONF" "$BAK"
    # Update only the managed connection.  A global sed replacement can
    # silently alter unrelated site-to-site connections.
    ID="$ID" awk '
      BEGIN { target=0; changed=0 }
      /^conn[[:space:]]+/ {
        target = ($0 ~ /^conn[[:space:]]+ikev2-vpn[[:space:]]*$/)
      }
      target && /^[[:space:]]*leftid[[:space:]]*=/ {
        print "    leftid=" ENVIRON["ID"]; changed=1; next
      }
      target && /^[[:space:]]*left[[:space:]]*=/ && !changed {
        print; print "    leftid=" ENVIRON["ID"]; changed=1; next
      }
      { print }
      END { if (!changed) exit 4 }
    ' "$BAK" > "${IPSEC_CONF}.tmp.$$"
    install -o root -g root -m 600 "${IPSEC_CONF}.tmp.$$" "$IPSEC_CONF"
    rm -f "${IPSEC_CONF}.tmp.$$" "$BAK"
    echo "leftid=${ID}"
    ;;
  normalize-conn)
    [[ -f "$IPSEC_CONF" && ! -L "$IPSEC_CONF" ]] || { echo "ipsec.conf missing" >&2; exit 3; }
    TMP="${IPSEC_CONF}.tmp.$$"
    awk '
      BEGIN { setup=0; setup_seen=0; target=0; target_seen=0 }
      /^[[:space:]]*config[[:space:]]+setup[[:space:]]*$/ { setup=1; setup_seen=1; print; next }
      /^[[:space:]]*conn[[:space:]]+/ {
        if (setup && !setup_seen_unique) { print "    uniqueids=never"; setup_seen_unique=1 }
        setup=0
        target=($0 ~ /^[[:space:]]*conn[[:space:]]+ikev2-vpn[[:space:]]*$/)
        if (target) {
          target_seen=1
          print
          print "    keyexchange=ikev2"
          print "    dpdaction=clear"
          print "    dpddelay=30s"
          print "    dpdtimeout=120s"
          print "    rekey=no"
          print "    forceencaps=yes"
          print "    ike=aes128-sha256-ecp256,aes128-sha256-modp2048,aes256-sha256-modp2048,aes128-sha1-modp1024,aes256-sha1-modp1024"
          print "    esp=aes128-sha256,aes256-sha256,aes128-sha1,aes256-sha1"
          next
        }
      }
      setup && /^[[:space:]]*uniqueids[[:space:]]*=/ { print "    uniqueids=never"; setup_seen_unique=1; next }
      target && /^[[:space:]]*(keyexchange|dpdaction|dpddelay|dpdtimeout|rekey|forceencaps|ike|esp)[[:space:]]*=/ { next }
      { print }
      END { if (setup && !setup_seen_unique) print "    uniqueids=never"; if (!target_seen) exit 4 }
    ' "$IPSEC_CONF" > "$TMP" || { rm -f "$TMP"; echo "conn ikev2-vpn missing" >&2; exit 3; }
    install -o root -g root -m 600 "$TMP" "$IPSEC_CONF"
    rm -f "$TMP"
    ;;
  restart-strongswan)
    systemctl restart strongswan-starter
    sleep 2
    systemctl is-active --quiet strongswan-starter
    ;;
  *)
    echo "unsupported action" >&2
    exit 2
    ;;
esac
