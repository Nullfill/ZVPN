[Unit]
Description=ZVPN local Psiphon upstream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zvpn-psiphon
Group=zvpn-psiphon
StateDirectory=zvpn-panel/psiphon
StateDirectoryMode=0700
ExecStart=/usr/local/bin/zvpn-psiphon -config /etc/zvpn/psiphon.json -listenInterface lo
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
